# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build
/dist
# Vite 프로젝트지만 tsconfig incremental 산출물이 여기로 떨어진다 (#404)
.next/
# Next.js leftovers — this is a Vite project; #402 committed both by accident (#691).
next-env.d.ts
# mkdocs 빌드 산출물(배포 시 CI에서 생성)
/site

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets must not be committed)
.env
.env.local
.env.*.local
# Development defaults are safe to commit (no secrets)
!.env.development
!.env.development.real

# vercel
.vercel

# typescript
*.tsbuildinfo

# local tooling
.claude/

# .npmrc is tracked: it pins the registry (#431). Credentials belong in
# ~/.npmrc, never here — __tests__/localToolchainGate.test.ts fails on one.

# Playwright E2E (#268)
/test-results/
/playwright-report/
# Production build the csp e2e project serves (#663)
/.csp-preview/

# Screenshot baselines are Linux renders (e2e/visual.spec.ts); a macOS or Windows run
# must not add its own next to them.
e2e/**/*-darwin.png
e2e/**/*-win32.png

# Builder contract checkout used by the Node 22 test leg in CI (ci.yml `test`)
.builder/
