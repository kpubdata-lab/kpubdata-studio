{
  "name": "kpubdata-studio",
  "version": "0.4.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "private": true,
  "homepage": "https://github.com/kpubdata-lab/kpubdata-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kpubdata-lab/kpubdata-studio.git"
  },
  "bugs": {
    "url": "https://github.com/kpubdata-lab/kpubdata-studio/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/check-bundle-size.mjs",
    "size:check": "node scripts/check-bundle-size.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update-visual": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work -e CI=1 mcr.microsoft.com/playwright:v1.63.0-noble sh -c 'npm ci --no-audit --no-fund && npx playwright test e2e/visual.spec.ts --project=desktop-chromium --update-snapshots; status=$?; chown -R \"$(stat -c %u:%g package.json)\" e2e/visual.spec.ts-snapshots; exit $status'",
    "test:e2e:real": "node scripts/run-real-e2e.mjs",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "i18n:check": "node scripts/i18n-coverage.mjs --check",
    "check:stale-ui": "node scripts/check-stale-ui-literals.mjs --base origin/main",
    "i18n:keys": "node scripts/check-i18n-keys.mjs",
    "i18n:terms": "node scripts/ko-mixed-terms.mjs",
    "contract:floor": "node scripts/contract-floor.mjs",
    "contract:enums": "node scripts/generate-builder-enums.mjs"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "keycloak-js": "^26.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "vitest": {
      "msw": "$msw"
    },
    "@vitest/mocker": {
      "msw": "$msw"
    }
  }
}
