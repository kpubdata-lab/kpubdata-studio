{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/builds/layout,_N_T_/builds/new/layout,_N_T_/builds/new/page,_N_T_/builds/new"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/builds/new/__PAGE__",
    "/builds/new",
    "/builds",
    "/_index",
    "/_head"
  ]
}